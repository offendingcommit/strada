{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "minilab-strada-otel-ingester",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "observability": {
    "enabled": true,
  },
  // Project ID is a URL path segment: ingest.d6e.us/{projectId}/v1/traces.
  "routes": [
    {
      "pattern": "ingest.d6e.us",
      "custom_domain": true,
    },
  ],
  // Shared D1 database with the website — used to resolve project → database config.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "strada-minilab",
      "database_id": "efe0a376-b60e-4cdd-8594-fbfaa96b6f3e",
    },
  ],
  "ratelimits": [
    {
      "name": "ANON_INGEST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 400,
        "period": 60
      }
    }
  ],
  "env": {
    "preview": {
      "name": "minilab-strada-otel-ingester-preview",
      "routes": [
        {
          "pattern": "ingest-preview.d6e.us",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "strada-minilab-preview",
          "database_id": "27998c96-5a4b-433e-817e-20eedb863380"
        }
      ],
      "ratelimits": [
        {
          "name": "ANON_INGEST_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 400,
            "period": 60
          }
        }
      ]
    }
  }
}
