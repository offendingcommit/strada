{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "minilab-strada-website",
  "compatibility_date": "2026-04-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "spiceflow/cloudflare-entrypoint",
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true,
  },
  "limits": {
    "subrequests": 100000,
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "send_email": [
    { "name": "EMAIL", "remote": true, "allowed_sender_addresses": ["alerts@d6e.us"] },
  ],
  "ai": {
    "binding": "AI",
  },
  "workflows": [
    {
      "name": "health-check-workflow",
      "binding": "HEALTH_CHECK_WORKFLOW",
      "class_name": "HealthCheckWorkflow"
    },
  ],
  "vars": {
    "STRADA_PROJECT_ID": "",
    "STRADA_ADMIN_EMAIL": "admin@strada.d6e.us",
    "STRADA_INGEST_HOST_SUFFIX": "ingest.d6e.us",
    "BETTER_AUTH_URL": "https://strada.d6e.us",
    "STRADA_TOKEN": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "strada-minilab",
      "database_id": "efe0a376-b60e-4cdd-8594-fbfaa96b6f3e",
      "migrations_dir": "../db/drizzle",
    },
  ],
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "STRADA_BOOTSTRAP_TOKEN",
    ],
  },
  "routes": [
    {
      "pattern": "strada.d6e.us",
      "custom_domain": true,
    },
  ],
  "env": {
    "preview": {
      "name": "minilab-strada-website-preview",
      "ai": {
        "binding": "AI",
      },
      "workflows": [
        {
          "name": "health-check-workflow-preview",
          "binding": "HEALTH_CHECK_WORKFLOW",
          "class_name": "HealthCheckWorkflow"
        },
      ],
      "limits": {
        "subrequests": 100000,
      },
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
      "send_email": [
        { "name": "EMAIL", "allowed_sender_addresses": ["alerts@d6e.us"] },
      ],
      "vars": {
        "STRADA_PROJECT_ID": "",
        "STRADA_ADMIN_EMAIL": "admin@strada.d6e.us",
        "STRADA_INGEST_HOST_SUFFIX": "ingest-preview.d6e.us",
        "BETTER_AUTH_URL": "https://strada-preview.d6e.us",
        "STRADA_TOKEN": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "strada-minilab-preview",
          "database_id": "27998c96-5a4b-433e-817e-20eedb863380",
          "migrations_dir": "../db/drizzle",
        },
      ],
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "STRADA_BOOTSTRAP_TOKEN",
        ],
      },
      "routes": [
        {
          "pattern": "strada-preview.d6e.us",
          "custom_domain": true,
          "zone_name": "d6e.us",
        },
      ],
    },
  },
}
